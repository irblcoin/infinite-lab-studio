# Cloudflare Pages headers for ILS – Infinite Lab Studio
# Long-lived immutable caching for sound packs and hashed build assets.

/packs/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), midi=(self), autoplay=(self)

# Explicit audio MIME types for the sample packs (some CDNs omit them).
/packs/*.mp3
  Content-Type: audio/mpeg
/packs/*.wav
  Content-Type: audio/wav
/packs/*.flac
  Content-Type: audio/flac
/packs/*.ogg
  Content-Type: audio/ogg
